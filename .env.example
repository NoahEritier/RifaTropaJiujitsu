# Copiar a .env.local. Generar ADMIN_KEY con npm run local:setup.
ADMIN_KEY="replace-with-a-random-secret-of-at-least-32-characters"
# Producción: SQLite persistente en Turso y comprobantes privados en Vercel Blob.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
BLOB_READ_WRITE_TOKEN=""
# Sólo para probar next start con datos locales, nunca configurar en Vercel.
ALLOW_LOCAL_DATA=""